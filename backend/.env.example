## SkillSwap Environment Variables
## Copy this file to .env and fill in your real credentials
## NEVER commit the .env file to version control

# MongoDB connection string
# Format: mongodb+srv://<username>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/skillswap?retryWrites=true&w=majority

# JWT secret — use a long, random string
JWT_SECRET=replace_this_with_a_secure_random_secret

# Optional SMTP settings for email/OTP notifications
# Leave blank to run in dev mode (OTP printed to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false
EMAIL_FROM=SkillSwap <your_email@gmail.com>
ADMIN_EMAIL=admin@example.com
